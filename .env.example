# ---------------------------------------------------------------------------
# Financial Analysis Agent Crew — environment template
# Copy to .env and fill in your keys:  cp .env.example .env
# Never commit .env (it is git-ignored).
# ---------------------------------------------------------------------------

# --- Required for the live agent crew -------------------------------------
# Google AI Studio key: https://aistudio.google.com/app/apikey
# Leave blank to run the deterministic offline crew (no LLM, still full report).
GOOGLE_API_KEY=

# --- Optional -------------------------------------------------------------
# NewsAPI.org key. DuckDuckGo is used by default and needs no key.
NEWS_API_KEY=

# --- Model ----------------------------------------------------------------
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=120

# --- Crew behaviour -------------------------------------------------------
# How many times the orchestrator may send the draft back to the Report Writer.
MAX_REVISION_ROUNDS=2
TEAM_MODE=coordinate
TEAM_MAX_ITERATIONS=6
SHOW_MEMBERS_RESPONSES=true
# "lexicon" (default, no key) or "llm"
SENTIMENT_BACKEND=lexicon

# --- Data -----------------------------------------------------------------
RISK_FREE_RATE=0.04
TRADING_DAYS=252
MAX_NEWS_RESULTS=8
NEWS_LOOKBACK_DAYS=30
REQUEST_TIMEOUT_SECONDS=20

# Synthetic fallback when live providers are unreachable. Demo reports are
# always labelled "SYNTHETIC DEMO DATA" in the UI, the log and the PDF.
ALLOW_DEMO_DATA=true
FORCE_DEMO_DATA=false

# --- Output / logging -----------------------------------------------------
REPORTS_DIR=reports/output
LOG_DIR=logs
LOG_LEVEL=INFO

# --- Optional automation (scripts/daily_report.py) ------------------------
# Comma-separated tickers for scheduled reports
DAILY_TICKERS=AAPL,MSFT,NVDA
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
